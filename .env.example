# Synthetic local-development credentials only. Do not reuse in production.
SUPPORT_PILOT_DATABASE_URL=postgresql+psycopg://support_pilot:support_pilot@localhost:54329/support_pilot
SUPPORT_PILOT_AGENT_PROVIDER=deterministic
SUPPORT_PILOT_JWT_SECRET=
SUPPORT_PILOT_ALLOW_LEGACY_USER_HEADER=false
SUPPORT_PILOT_OTEL_ENABLED=false
SUPPORT_PILOT_OTEL_SERVICE_NAME=support-pilot-api
SUPPORT_PILOT_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Set only in ignored .env when agent_provider=qwen. Never commit a real key.
# The standard DASHSCOPE_API_KEY environment variable is also supported.
SUPPORT_PILOT_QWEN_API_KEY=
SUPPORT_PILOT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SUPPORT_PILOT_QWEN_MODEL=qwen3.7-plus
SUPPORT_PILOT_QWEN_TIMEOUT_SECONDS=15
SUPPORT_PILOT_QWEN_ENABLE_THINKING=false
SUPPORT_PILOT_QWEN_INPUT_PRICE_PER_MILLION_CNY=2
SUPPORT_PILOT_QWEN_OUTPUT_PRICE_PER_MILLION_CNY=8
SUPPORT_PILOT_RETRIEVAL_PROVIDER=deterministic
SUPPORT_PILOT_MODEL_CACHE_DIR=D:/model-cache/support-pilot/huggingface
SUPPORT_PILOT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SUPPORT_PILOT_RERANKER_MODEL=BAAI/bge-reranker-base
# Notification channel: log (default), smtp, or webhook.
SUPPORT_PILOT_NOTIFICATION_CHANNEL=log
# SMTP settings (used only when notification_channel=smtp; keep real values in ignored .env).
SUPPORT_PILOT_SMTP_HOST=
SUPPORT_PILOT_SMTP_PORT=587
SUPPORT_PILOT_SMTP_USERNAME=
SUPPORT_PILOT_SMTP_PASSWORD=
SUPPORT_PILOT_SMTP_USE_TLS=true
SUPPORT_PILOT_SMTP_FROM_EMAIL=
SUPPORT_PILOT_SMTP_TO_EMAIL=
# Group webhook (used only when notification_channel=webhook).
SUPPORT_PILOT_WEBHOOK_URL=
SUPPORT_PILOT_CHANNEL_REQUEST_TIMEOUT_SECONDS=10
